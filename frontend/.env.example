# HawaCommand web console configuration. Copy to frontend/.env.local.
# NEXT_PUBLIC_* values are baked in at build time (`pnpm build`), so rebuild after changing them.

# Backend base URL, without a trailing slash and without /v1 (src/lib/api.ts, src/lib/time.ts).
# Empty: every /v1 call is answered in the browser by src/mocks/ (demo clock is fixed).
# Local full stack: http://localhost:8000. On a server: http://<server-ip>:8000 (reachable from the browser).
# `make frontend API_URL=...` sets this for the build and overrides this file.
NEXT_PUBLIC_API_URL=

# Cognito sign-in on /login (src/lib/auth.ts). Both set: sign-in required. Either empty: demo mode, no sign-in.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Used only by scripts/verify_backend_contracts.ts (default http://127.0.0.1:8099):
# API_URL=http://127.0.0.1:8000
