# HawaCommand backend configuration.
# Copy to backend/.env. Settings are read from backend/.env (resolved from the package location, so the
# working directory does not matter); real environment variables override it. Every variable is optional.

# --- Core (core/config.py, prefix HAWA_) -----------------------------------------------------
# development | staging | production (printed by `hawa config`)
HAWA_ENV=development
# Debug mode (also turns on SQL echo in db/session.py)
HAWA_DEBUG=true
# HAWA_HOST / HAWA_PORT exist in Settings but are not used to bind the server;
# use `make backend BACKEND_HOST=... BACKEND_PORT=...` or uvicorn's --host/--port.
HAWA_HOST=0.0.0.0
HAWA_PORT=8000

# --- Database (Alembic migrations, seed script, db/session.py) -------------------------------
HAWA_DATABASE_URL=postgresql+asyncpg://hawa:hawa@localhost:5432/hawa
# Demo without Postgres (file relative to backend/):
# HAWA_DATABASE_URL=sqlite+aiosqlite:///./hawa.db

# --- Redis (core/redis_store.py) -------------------------------------------------------------
# Shared state for several processes: live fleet geo index (geo:fleet:active), twin snapshot
# (grid:pm25:500m:<hour>), plans, push tokens, broadcast alerts, Kinesis checkpoints.
# Empty = process memory. ElastiCache: redis://<primary endpoint>:6379/0 (rediss:// with TLS).
HAWA_REDIS_URL=
# Kafka is declared but not used by any running code
HAWA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
HAWA_KAFKA_SECURITY=plaintext

# --- Auth helpers (core/security.py, core/identity.py) ---------------------------------------
HAWA_JWT_SECRET=supersecret-dev-key-change-in-production-12345
HAWA_JWT_ALGORITHM=HS256
HAWA_JWT_EXPIRY_MINUTES=1440
HAWA_DEV_OTP=123456
# Accept the `sub` of unverified bearer tokens (the app's in-app fake sign-in) to tell citizens apart
HAWA_TRUST_CLIENT_TOKENS=true
# X-Api-Key for officer writes (alert broadcast, SNS subscribers, report list/status). Empty = open (dev only)
HAWA_ADMIN_API_KEY=
# X-Api-Key for POST /v1/telemetry/vehicles. Empty = open (dev only)
HAWA_INGEST_API_KEY=

# --- Live fleet and citizen reports -----------------------------------------------------------
# Minutes without a ping before a vehicle leaves the live fleet
HAWA_FLEET_ACTIVE_MINUTES=15
# Hours to close a citizen report before it counts as an SLA breach
HAWA_REPORT_SLA_HOURS=3

# --- Firebase Cloud Messaging (services/push.py) ----------------------------------------------
# Credentials: one of HAWA_FCM_SERVICE_ACCOUNT_FILE, HAWA_FCM_SERVICE_ACCOUNT_JSON or HAWA_AWS_FCM_SECRET_ID
# HAWA_FCM_SERVICE_ACCOUNT_FILE=/home/ec2-user/firebase-service-account.json
# Topic every app install subscribes to (app define FCM_TOPIC)
HAWA_FCM_TOPIC=hawa-alerts

# --- AI-ML engine (core/intel_client.py) -----------------------------------------------------
HAWA_AIML_SERVICE_URL=http://localhost:8100
HAWA_AIML_TIMEOUT_SECONDS=10.0

# --- Live station feeds (core/intel_client.py) -----------------------------------------------
# WAQI is tried first; OpenAQ when WAQI returns fewer than 3 stations. Unset or empty skips that source;
# with neither, the backend uses 5 built-in baseline stations. HAWA_WAQI_TOKEN / HAWA_OPENAQ_API_KEY also work.
# Get a WAQI token at https://aqicn.org/data-platform/token/ and an OpenAQ key at https://explore.openaq.org/register
WAQI_TOKEN=
OPENAQ_API_KEY=

# --- Optional AWS layer (aws/settings.py, prefix HAWA_AWS_) ----------------------------------
# Everything AWS is off unless HAWA_AWS_ENABLED=true, and each service is off until its name/ARN is set.
# Credentials come from the default boto3 chain (IAM role, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_PROFILE exported in the shell; boto3 does not read .env). Check everything with: uv run hawa aws-check
# Step-by-step console setup: docs/AWS_SETUP_GUIDE.md
HAWA_AWS_ENABLED=false
HAWA_AWS_REGION=ap-south-1
# Secrets Manager JSON secret whose keys are env var names, loaded at startup (env vars win, then the secret, then this file)
# HAWA_AWS_SECRETS_ID=hawa/backend
# e.g. LocalStack
# HAWA_AWS_ENDPOINT_URL=http://localhost:4566
# Step Functions forecast (aws/forecast.py)
# HAWA_AWS_FORECAST_STATE_MACHINE_ARN=
# SageMaker endpoint name (aws/forecast.py)
# HAWA_AWS_FORECAST_ENDPOINT=
# Step Functions dispatch on plan approval (aws/dispatch.py)
# HAWA_AWS_DISPATCH_STATE_MACHINE_ARN=
# DynamoDB cache table (aws/cache.py)
HAWA_AWS_CACHE_TABLE=hawa-cache
HAWA_AWS_CACHE_TTL_SECONDS=3600
# SNS topic for alert broadcasts and plan approvals (aws/events.py, services/alerts.py)
# HAWA_AWS_ALERTS_TOPIC_ARN=arn:aws:sns:ap-south-1:<account-id>:hawa-citizen-push-alerts
# Publish an SNS notice when a plan is approved (turn off if your dispatch state machine publishes too)
HAWA_AWS_ALERT_ON_PLAN_APPROVAL=true
# Kinesis stream for vehicle telemetry: API pings are forwarded to it, the consumer reads IoT Core records from it
# HAWA_AWS_SENSOR_STREAM=hawa-sensor-data
# Run the Kinesis consumer inside the API process (or run `hawa consume-telemetry` separately; never both)
HAWA_AWS_KINESIS_CONSUMER=false
# Where a consumer with no checkpoint starts: LATEST or TRIM_HORIZON
HAWA_AWS_KINESIS_START=LATEST
# IoT Core device data endpoint, for `hawa simulate-fleet --target iot`
# HAWA_AWS_IOT_ENDPOINT=xxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com
# DynamoDB citizen grievances (services/reports.py): keys report_id + created_at, GSIs WardStatusIndex, OwnerIndex
# HAWA_AWS_GRIEVANCES_TABLE=hawa-citizen-grievances
HAWA_AWS_GRIEVANCES_WARD_INDEX=WardStatusIndex
# DynamoDB fleet telemetry (services/fleet.py): keys asset_id + timestamp, TTL attribute ttl_epoch
# HAWA_AWS_FLEET_TABLE=hawa-fleet-telemetry
HAWA_AWS_FLEET_TTL_DAYS=7
# Secrets Manager secret with the Firebase service-account JSON (services/push.py)
# HAWA_AWS_FCM_SECRET_ID=hawa/firebase/service-account

# Evidence photo uploads: POST /v1/uploads/presign returns a pre-signed S3 POST (aws/uploads.py).
# Needs HAWA_AWS_ENABLED=true and s3:PutObject on arn:aws:s3:::<bucket>/* for the backend's AWS identity.
# Bucket name only (no s3:// URI); the region is HAWA_AWS_REGION.
# HAWA_AWS_EVIDENCE_BUCKET=hawa-citizen-evidence-prod
# Optional key prefix, e.g. evidence/ (default: none)
# HAWA_AWS_EVIDENCE_PREFIX=
# Max upload size in bytes (default 5 MB)
HAWA_AWS_UPLOAD_MAX_BYTES=5242880
# Lifetime of a pre-signed upload in seconds (default 15 min)
HAWA_AWS_PRESIGN_TTL_SECONDS=900
# Lifetime of the pre-signed GET URLs for report photos (needs s3:GetObject)
HAWA_AWS_EVIDENCE_READ_TTL_SECONDS=3600

# Note: the in-process AI-ML fallback (hawa_ml) reads AI-ML/.env, not this file.
