# Environment configuration for HawaCommand Backend
HAWA_ENV=development
HAWA_DEBUG=true
HAWA_HOST=0.0.0.0
HAWA_PORT=8000

# Database (PostgreSQL 16 + PostGIS)
HAWA_DATABASE_URL=postgresql+asyncpg://hawa:hawa@localhost:5432/hawa
# Fallback sqlite for isolated unit tests
# HAWA_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis 7
HAWA_REDIS_URL=redis://localhost:6379/0

# Kafka
HAWA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
HAWA_KAFKA_SECURITY=plaintext

# JWT & Auth
HAWA_JWT_SECRET=supersecret-dev-key-change-in-production-12345
HAWA_JWT_ALGORITHM=HS256
HAWA_JWT_EXPIRY_MINUTES=1440
HAWA_DEV_OTP=123456

# AI-ML Internal Service
HAWA_AIML_SERVICE_URL=http://localhost:8100
HAWA_AIML_TIMEOUT_SECONDS=10.0
