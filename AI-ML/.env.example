# HawaCommand AI-ML Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.

# Ground truth & Air Quality APIs
OPENAQ_API_KEY=
WAQI_TOKEN=
DATA_GOV_IN_API_KEY=

# Satellite Fire Points (NASA FIRMS)
NASA_FIRMS_MAP_KEY=

# Weather / Reanalysis (Copernicus CDS)
CDS_API_KEY=

# LLM Providers (Groq for dev, Bedrock for production)
LLM_PROVIDER=groq
GROQ_API_KEY=

# AWS Credentials (for Bedrock and Strands Agents SDK)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Operational mode
OFFLINE_MODE=false
LOG_LEVEL=INFO
