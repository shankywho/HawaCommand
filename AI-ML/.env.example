# HawaCommand AI-ML engine configuration (hawa_ml/settings.py).
# Copy to AI-ML/.env. It is read from AI-ML/.env wherever hawa_ml runs (uvicorn, scripts, tests, and the
# backend's in-process fallback); real environment variables override it. Every key is optional:
# without keys the engine uses fixtures, synthetic data and template text. NEVER commit .env.

# --- Mode -------------------------------------------------------------------------------------
# true: no network calls; template LLM text and synthetic/fixture data everywhere
OFFLINE_MODE=false

# --- Air quality and fire data ----------------------------------------------------------------
# OpenAQ v3 station metadata (ingestion/openaq.py); empty uses data/fixtures/stations_fallback.csv
OPENAQ_API_KEY=
# NASA FIRMS VIIRS fire points (ingestion/firms.py); empty uses synthetic fires
NASA_FIRMS_MAP_KEY=

# --- LLM text for the agents (agents/llm_provider.py) ----------------------------------------
# groq | bedrock; anything else, or a missing key, gives deterministic template text
LLM_PROVIDER=groq
# Groq (model openai/gpt-oss-120b); needs the `llm` extra (groq/openai)
GROQ_API_KEY=
# Bedrock (needs the `llm` extra for boto3)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_REGION=ap-south-1
# Leave these commented to use the default AWS credential chain (IAM role, AWS_PROFILE).
# An empty value is passed to boto3 as an empty key and breaks role-based auth.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Declared in settings but not used by any code yet ----------------------------------------
# Reported by scripts/check_env.py only.
# WAQI_TOKEN=
# CDS_API_KEY=
# DATA_GOV_IN_API_KEY=
# Printed by scripts/check_env.py; not applied to the logger.
# LOG_LEVEL=INFO
